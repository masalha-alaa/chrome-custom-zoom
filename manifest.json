{
  "manifest_version": 3,
  "name": "Chrome Custom Zoom",
  "version": "1.2.0",
  "description": "Set exact page zoom, choose your own zoom step, save presets, and control Chrome's global font sizes.",
  "permissions": [
    "storage",
    "fontSettings"
  ],
  "icons": {
    "16": "icons/zoom-16.png",
    "32": "icons/zoom-32.png",
    "48": "icons/zoom-48.png",
    "128": "icons/zoom-128.png"
  },
  "action": {
    "default_title": "Custom Zoom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/zoom-16.png",
      "32": "icons/zoom-32.png"
    }
  },
  "homepage_url": "https://github.com/masalha-alaa/chrome-custom-zoom",
  "background": {
    "service_worker": "background.js"
  }
}
