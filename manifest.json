{
  "manifest_version": 3,
  "name": "Chrome Custom Zoom",
  "version": "1.0.0",
  "description": "Set an exact page zoom percentage using a compact Chrome-style control.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/zoom-16.png",
    "32": "icons/zoom-32.png",
    "48": "icons/zoom-48.png",
    "128": "icons/zoom-128.png"
  },
  "action": {
    "default_title": "Custom Zoom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/zoom-16.png",
      "32": "icons/zoom-32.png"
    }
  }
}
